# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App URL (used for authentication callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connection
DATABASE_URL=

# Better Auth Configuration
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Python Backend API URL
BACKEND_URL=http://localhost:8000

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=


# Multi-API Stock Data Providers
# These are optional but recommended for better reliability and fallback support
# Get free API keys from:
# - Alpha Vantage: https://www.alphavantage.co/support/#api-key (25/day free)
# - Finnhub: https://finnhub.io/register (60/min free)
# - Twelve Data: https://twelvedata.com/pricing (800/day free)
# - Financial Modeling Prep: https://site.financialmodelingprep.com/developer/docs/ (250/day free)

ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
FMP_API_KEY=

# Optional: Rate Limit Tuning (defaults are already conservative)
# Uncomment and adjust if needed for your use case
# YAHOO_FINANCE_RATE_LIMIT=10
# ALPHA_VANTAGE_RATE_LIMIT=5
# FINNHUB_RATE_LIMIT=60
# TWELVE_DATA_DAILY_LIMIT=800

# Optional: Python environment for forecasting (if using forecast features)
# PYTHON_PATH=/usr/bin/python3
# FORECAST_SCRIPT_PATH=/path/to/forecast/script.py
